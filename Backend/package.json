{
  "name": "lockedin-backend",
  "version": "1.0.0",
  "description": "Backend API & AI Intelligence Engine for LockedIn AI Mock Interview Platform",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "npx prisma generate && npx prisma db push && npx tsx prisma/seed.ts && npx tsc",
